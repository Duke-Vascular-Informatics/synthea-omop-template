    },

    "Functional_Impairment_Onset": {
      "type": "ConditionOnset",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "82971005",
          "display": "Impaired mobility"
        }
      ],
      "direct_transition": "BMI_Chance"
    },

    "BMI_Chance": {
      "type": "Simple",
      "remarks": [
        "Obesity prevalence is modeled at 40%.",
        "Overweight (BMI 25-29.9) is modeled at 30%.",
        "Normal/underweight at 30%."
      ],
      "distributed_transition": [
        { "distribution": 0.40, "transition": "BMI_Obese_Observation" },
        { "distribution": 0.30, "transition": "BMI_Overweight_Observation" },
        { "distribution": 0.30, "transition": "BMI_Normal_Observation" }
      ]
    },

    "BMI_Obese_Observation": {
