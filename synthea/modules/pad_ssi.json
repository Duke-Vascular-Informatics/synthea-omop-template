      "category": "survey",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "84387000",
          "display": "Asymptomatic"
        }
      ],
      "remarks": ["Rutherford category 0 — no symptoms."],
      "direct_transition": "Smoking_Status_Chance"
    },

    "Symptom_Claudication": {
      "type": "ConditionOnset",
