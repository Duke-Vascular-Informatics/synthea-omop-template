{
  "name": "PAD Open Lower Extremity Revascularization with SSI",
  "remarks": [
    "Models open lower extremity revascularization surgery in patients with peripheral",
    "arterial disease (PAD) and simulates surgical site infection (SSI) as a 30-day",
    "outcome. Designed to generate synthetic OMOP CDM v5 data compatible with the",
    "PAD/OLER SSI validation study cohort definitions:",
    "  Target  : inpatient surgery for open lower extremity revascularization",
    "  Outcome : SSI diagnosis within 30 days of index surgery",
    "",
    "This module is self-contained. It generates a PAD diagnosis, schedules an inpatient",
    "revascularization, and applies comorbidity-adjusted SSI risk. It also generates",
    "risk-model variables used by the PAD/OLER validation pipeline: claudication",
    "indication, ABI severity, urgency flag, prior revascularization, pre-index",
    "prolonged antibiotic exposure, BMI/height/weight, and modified frailty",
    "comorbidities (diabetes, COPD, CHF, hypertension, functional impairment).",
    "",
    "SSI incidence assumptions (per published literature):",
    "  With Type 2 diabetes                 : 12%",
    "  With obesity (BMI >= 30), no DM      : 10%",
    "  With current smoking only            : 9%",
    "  Baseline (no major risk factors)     : 6%",
    "  Requiring rehospitalization/re-op    : 15% of SSI cases",
    "",
    "Comorbidity prevalence assumptions in this surgical PAD population:",
    "  Current smoker                       : 35%",
    "  Type 2 diabetes mellitus             : 30%",
    "  Obesity (BMI >= 30)                  : 40%",
    "",
    "Primary concept codes (OMOP-mappable):",
    "  PAD condition          : SNOMED-CT 399957001",
    "  Femoro-popliteal bypass: SNOMED-CT 232723009",
    "  SSI condition          : SNOMED-CT 76844004",
    "  Debridement (re-op)    : SNOMED-CT 118294005",
    "  Ankle-brachial index   : LOINC     59574-4",
    "  Wound culture          : LOINC     6463-4",
    "  Tobacco smoking status : LOINC     72166-2",
    "  BMI                    : LOINC     39156-5",
    "  Cefazolin (ppx)        : RxNorm    20496",
    "  Cephalexin (SSI tx)    : RxNorm    2673",
    "",
    "Timing:",
    "  Pre-surgical workup delay : 1-6 months after PAD diagnosis",
    "  Inpatient stay            : 3-7 days post-surgery",
    "  SSI onset window          : 5-25 days post-discharge (8-32 days post-surgery)",
    "  SSI antibiotic course     : 7-14 days",
    "  Rehospitalization stay    : 7-21 days",
    "",
    "Usage:",
    "  Copy to <synthea_home>/src/main/resources/modules/ and run Synthea normally.",
    "  To load into the omop_synth database, run the Synthea-OMOP ETL pipeline against",
    "  the generated CSV output.",
    "",
    "Does NOT model: mortality, limb loss, graft failure, or recurrent PAD."
  ],
  "states": {

    "Initial": {
      "type": "Initial",
      "direct_transition": "Age_Guard"
    },

    "Age_Guard": {
      "type": "Guard",
      "allow": {
        "condition_type": "Age",
        "operator": ">=",
        "quantity": 40,
        "unit": "years"
      },
      "direct_transition": "PAD_Onset_Chance"
    },

    "PAD_Onset_Chance": {
      "type": "Simple",
      "remarks": [
        "PAD-only generation mode.",
        "All generated adults meeting the age guard are routed into the PAD pathway."
      ],
      "direct_transition": "PAD_Onset"
    },

    "PAD_Onset": {
      "type": "ConditionOnset",
      "target_encounter": "PAD_Diagnosis_Encounter",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "399957001",
          "display": "Peripheral arterial occlusive disease"
        }
      ],
      "direct_transition": "PAD_Diagnosis_Encounter"
    },

    "PAD_Diagnosis_Encounter": {
      "type": "Encounter",
      "encounter_class": "outpatient",
      "reason": "PAD_Onset",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "185349003",
          "display": "Encounter for check up"
        }
      ],
      "direct_transition": "ABI_Observation"
    },

    "ABI_Observation": {
      "type": "Observation",
      "category": "vital-signs",
      "unit": "ratio",
      "codes": [
        {
          "system": "LOINC",
          "code": "59574-4",
          "display": "Ankle-brachial index"
        }
      ],
      "remarks": [
        "ABI < 0.9 indicates PAD; < 0.5 indicates severe/critical limb ischemia.",
        "Range reflects moderate-to-severe PAD requiring revascularization."
      ],
      "range": { "low": 0.3, "high": 0.85 },
      "direct_transition": "End_PAD_Diagnosis_Encounter"
    },

    "End_PAD_Diagnosis_Encounter": {
      "type": "EncounterEnd",
      "direct_transition": "Claudication_Chance"
    },

    "Claudication_Chance": {
      "type": "Simple",
      "remarks": [
        "Most surgical PAD presentations in this module include intermittent claudication."
      ],
      "distributed_transition": [
        { "distribution": 0.70, "transition": "Claudication_Onset" },
        { "distribution": 0.30, "transition": "Smoking_Status_Chance" }
      ]
    },

    "Claudication_Onset": {
      "type": "ConditionOnset",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "266261006",
          "display": "Intermittent claudication"
        }
      ],
      "direct_transition": "Smoking_Status_Chance"
    },

    "Smoking_Status_Chance": {
      "type": "Simple",
      "remarks": [
        "Current smoking prevalence in PAD revascularization candidates is modeled at 35%."
      ],
      "distributed_transition": [
        { "distribution": 0.35, "transition": "Current_Smoker_Observation" },
        { "distribution": 0.65, "transition": "Non_Smoker_Observation" }
      ]
    },

    "Current_Smoker_Observation": {
      "type": "Observation",
      "category": "social-history",
      "codes": [
        {
          "system": "LOINC",
          "code": "72166-2",
          "display": "Tobacco smoking status"
        }
      ],
      "value_code": {
        "system": "SNOMED-CT",
        "code": "449868002",
        "display": "Current every day smoker"
      },
      "direct_transition": "Diabetes_Chance"
    },

    "Non_Smoker_Observation": {
      "type": "Observation",
      "category": "social-history",
      "codes": [
        {
          "system": "LOINC",
          "code": "72166-2",
          "display": "Tobacco smoking status"
        }
      ],
      "value_code": {
        "system": "SNOMED-CT",
        "code": "266919005",
        "display": "Never smoked tobacco"
      },
      "direct_transition": "Diabetes_Chance"
    },

    "Diabetes_Chance": {
      "type": "Simple",
      "remarks": [
        "Type 2 diabetes prevalence in PAD surgery patients is modeled at 30%."
      ],
      "distributed_transition": [
        { "distribution": 0.30, "transition": "Diabetes_Onset" },
        { "distribution": 0.70, "transition": "Hypertension_Chance" }
      ]
    },

    "Diabetes_Onset": {
      "type": "ConditionOnset",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "44054006",
          "display": "Diabetes mellitus type 2"
        }
      ],
      "direct_transition": "Hypertension_Chance"
    },

    "Hypertension_Chance": {
      "type": "Simple",
      "distributed_transition": [
        { "distribution": 0.60, "transition": "Hypertension_Onset" },
        { "distribution": 0.40, "transition": "COPD_Chance" }
      ]
    },

    "Hypertension_Onset": {
      "type": "ConditionOnset",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "38341003",
          "display": "Hypertensive disorder, systemic arterial"
        }
      ],
      "direct_transition": "COPD_Chance"
    },

    "COPD_Chance": {
      "type": "Simple",
      "distributed_transition": [
        { "distribution": 0.20, "transition": "COPD_Onset" },
        { "distribution": 0.80, "transition": "CHF_Chance" }
      ]
    },

    "COPD_Onset": {
      "type": "ConditionOnset",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "13645005",
          "display": "Chronic obstructive lung disease"
        }
      ],
      "direct_transition": "CHF_Chance"
    },

    "CHF_Chance": {
      "type": "Simple",
      "distributed_transition": [
        { "distribution": 0.15, "transition": "CHF_Onset" },
        { "distribution": 0.85, "transition": "Functional_Impairment_Chance" }
      ]
    },

    "CHF_Onset": {
      "type": "ConditionOnset",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "84114007",
          "display": "Heart failure"
        }
      ],
      "direct_transition": "Functional_Impairment_Chance"
    },

    "Functional_Impairment_Chance": {
      "type": "Simple",
      "distributed_transition": [
        { "distribution": 0.20, "transition": "Functional_Impairment_Onset" },
        { "distribution": 0.80, "transition": "BMI_Chance" }
      ]
    },

    "Functional_Impairment_Onset": {
      "type": "ConditionOnset",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "129839007",
          "display": "Impaired mobility"
        }
      ],
      "direct_transition": "BMI_Chance"
    },

    "BMI_Chance": {
      "type": "Simple",
      "remarks": [
        "Obesity prevalence is modeled at 40% using a BMI observation."
      ],
      "distributed_transition": [
        { "distribution": 0.40, "transition": "BMI_Obese_Observation" },
        { "distribution": 0.60, "transition": "BMI_NonObese_Observation" }
      ]
    },

    "BMI_Obese_Observation": {
      "type": "Observation",
      "category": "vital-signs",
      "unit": "kg/m2",
      "codes": [
        {
          "system": "LOINC",
          "code": "39156-5",
          "display": "Body Mass Index"
        }
      ],
      "range": { "low": 30, "high": 40 },
      "direct_transition": "Height_Obese_Observation"
    },

    "Height_Obese_Observation": {
      "type": "Observation",
      "category": "vital-signs",
      "unit": "cm",
      "codes": [
        {
          "system": "LOINC",
          "code": "8302-2",
          "display": "Body height"
        }
      ],
      "range": { "low": 155, "high": 188 },
      "direct_transition": "Weight_Obese_Observation"
    },

    "Weight_Obese_Observation": {
      "type": "Observation",
      "category": "vital-signs",
      "unit": "kg",
      "codes": [
        {
          "system": "LOINC",
          "code": "29463-7",
          "display": "Body weight"
        }
      ],
      "range": { "low": 90, "high": 130 },
      "direct_transition": "Prior_Revascularization_Chance"
    },

    "BMI_NonObese_Observation": {
      "type": "Observation",
      "category": "vital-signs",
      "unit": "kg/m2",
      "codes": [
        {
          "system": "LOINC",
          "code": "39156-5",
          "display": "Body Mass Index"
        }
      ],
      "range": { "low": 22, "high": 29.9 },
      "direct_transition": "Height_NonObese_Observation"
    },

    "Height_NonObese_Observation": {
      "type": "Observation",
      "category": "vital-signs",
      "unit": "cm",
      "codes": [
        {
          "system": "LOINC",
          "code": "8302-2",
          "display": "Body height"
        }
      ],
      "range": { "low": 155, "high": 188 },
      "direct_transition": "Weight_NonObese_Observation"
    },

    "Weight_NonObese_Observation": {
      "type": "Observation",
      "category": "vital-signs",
      "unit": "kg",
      "codes": [
        {
          "system": "LOINC",
          "code": "29463-7",
          "display": "Body weight"
        }
      ],
      "range": { "low": 60, "high": 90 },
      "direct_transition": "Prior_Revascularization_Chance"
    },

    "Prior_Revascularization_Chance": {
      "type": "Simple",
      "distributed_transition": [
        { "distribution": 0.25, "transition": "Prior_Revascularization_Delay" },
        { "distribution": 0.75, "transition": "Pre_Surgical_Workup_Delay" }
      ]
    },

    "Prior_Revascularization_Delay": {
      "type": "Delay",
      "range": { "low": 30, "high": 365, "unit": "days" },
      "direct_transition": "Prior_Revascularization_Procedure"
    },

    "Prior_Revascularization_Procedure": {
      "type": "Procedure",
      "reason": "PAD_Onset",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "232723009",
          "display": "Bypass of femoral artery to popliteal artery"
        }
      ],
      "duration": { "low": 2, "high": 4, "unit": "hours" },
      "direct_transition": "Prior_Revascularization_Recovery"
    },

    "Prior_Revascularization_Recovery": {
      "type": "Delay",
      "range": { "low": 14, "high": 60, "unit": "days" },
      "direct_transition": "Pre_Surgical_Workup_Delay"
    },

    "Pre_Index_Antibiotic_Chance": {
      "type": "Simple",
      "distributed_transition": [
        { "distribution": 0.30, "transition": "Pre_Index_Antibiotic_Order" },
        { "distribution": 0.70, "transition": "Urgent_Case_Chance" }
      ]
    },

    "Pre_Index_Antibiotic_Order": {
      "type": "MedicationOrder",
      "assign_to_attribute": "preop_nonprophylaxis_antibiotic",
      "reason": "PAD_Onset",
      "codes": [
        {
          "system": "RxNorm",
          "code": "2673",
          "display": "cephalexin"
        }
      ],
      "direct_transition": "Pre_Index_Antibiotic_Delay"
    },

    "Pre_Index_Antibiotic_Delay": {
      "type": "Delay",
      "range": { "low": 3, "high": 10, "unit": "days" },
      "direct_transition": "Pre_Index_Antibiotic_End"
    },

    "Pre_Index_Antibiotic_End": {
      "type": "MedicationEnd",
      "referenced_by_attribute": "preop_nonprophylaxis_antibiotic",
      "direct_transition": "Urgent_Case_Chance"
    },

    "Pre_Surgical_Workup_Delay": {
      "type": "Delay",
      "remarks": [
        "Time from PAD diagnosis to open revascularization surgery.",
        "Includes pre-operative imaging, cardiac risk stratification, and scheduling."
      ],
      "range": { "low": 1, "high": 6, "unit": "months" },
      "direct_transition": "Pre_Index_Antibiotic_Chance"
    },

    "Urgent_Case_Chance": {
      "type": "Simple",
      "remarks": [
        "Subset of surgeries are flagged urgent/emergent for risk-score compatibility."
      ],
      "distributed_transition": [
        { "distribution": 0.25, "transition": "Urgent_Case_Observation" },
        { "distribution": 0.75, "transition": "Surgical_Admission" }
      ]
    },

    "Urgent_Case_Observation": {
      "type": "Observation",
      "category": "survey",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "25876001",
          "display": "Emergency operation"
        }
      ],
      "direct_transition": "Surgical_Admission"
    },

    "Surgical_Admission": {
      "type": "Encounter",
      "encounter_class": "inpatient",
      "reason": "PAD_Onset",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "32485007",
          "display": "Hospital admission"
        }
      ],
      "direct_transition": "Pre_Op_Antibiotic"
    },

    "Pre_Op_Antibiotic": {
      "type": "MedicationOrder",
      "assign_to_attribute": "prophylactic_antibiotic",
      "reason": "PAD_Onset",
      "remarks": [
        "Single-dose perioperative cefazolin per SCIP/ACS NSQIP guidelines.",
        "Ended immediately after the procedure."
      ],
      "codes": [
        {
          "system": "RxNorm",
          "code": "20496",
          "display": "cefazolin"
        }
      ],
      "direct_transition": "Revascularization_Procedure"
    },

    "Revascularization_Procedure": {
      "type": "Procedure",
      "reason": "PAD_Onset",
      "remarks": [
        "Femoro-popliteal bypass is modeled as the representative open LE revascularization.",
        "To model additional procedure types (aortofemoral bypass SNOMED 174814006,",
        "femoral endarterectomy SNOMED 85356008), replace with a distributed_transition",
        "to separate procedure states."
      ],
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "232723009",
          "display": "Bypass of femoral artery to popliteal artery"
        }
      ],
      "duration": { "low": 2, "high": 5, "unit": "hours" },
      "direct_transition": "Pre_Op_Antibiotic_End"
    },

    "Pre_Op_Antibiotic_End": {
      "type": "MedicationEnd",
      "referenced_by_attribute": "prophylactic_antibiotic",
      "direct_transition": "Post_Op_Inpatient_Delay"
    },

    "Post_Op_Inpatient_Delay": {
      "type": "Delay",
      "remarks": [
        "Standard inpatient stay after open lower extremity bypass: 3-7 days."
      ],
      "range": { "low": 3, "high": 7, "unit": "days" },
      "direct_transition": "End_Surgical_Admission"
    },

    "End_Surgical_Admission": {
      "type": "EncounterEnd",
      "direct_transition": "Post_Discharge_Delay"
    },

    "Post_Discharge_Delay": {
      "type": "Delay",
      "remarks": [
        "Time from hospital discharge to SSI diagnosis (if SSI occurs).",
        "Combined with inpatient stay (3-7 days), the SSI onset window is 8-32 days",
        "post-surgery — consistent with 30-day outcome definition in target study."
      ],
      "range": { "low": 5, "high": 25, "unit": "days" },
      "direct_transition": "SSI_Risk_Check"
    },

    "SSI_Risk_Check": {
      "type": "Simple",
      "remarks": [
        "Adjusts SSI probability based on module-generated comorbidities.",
        "Checks diabetes first, then obesity, then current smoking."
      ],
      "conditional_transition": [
        {
          "condition": {
            "condition_type": "Active Condition",
            "codes": [
              {
                "system": "SNOMED-CT",
                "code": "44054006",
                "display": "Diabetes mellitus type 2"
              }
            ]
          },
          "transition": "SSI_High_Risk"
        },
        {
          "condition": {
            "condition_type": "Observation",
            "codes": [
              {
                "system": "LOINC",
                "code": "39156-5",
                "display": "Body Mass Index"
              }
            ],
            "operator": ">=",
            "value": 30
          },
          "transition": "SSI_Moderate_Risk"
        },
        {
          "condition": {
            "condition_type": "Observation",
            "codes": [
              {
                "system": "LOINC",
                "code": "72166-2",
                "display": "Tobacco smoking status"
              }
            ],
            "value_code": {
              "system": "SNOMED-CT",
              "code": "449868002",
              "display": "Current every day smoker"
            }
          },
          "transition": "SSI_Smoking_Risk"
        },
        {
          "transition": "SSI_Baseline_Risk"
        }
      ]
    },

    "SSI_High_Risk": {
      "type": "Simple",
      "remarks": ["12% SSI incidence with diabetes."],
      "distributed_transition": [
        { "distribution": 0.12, "transition": "SSI_Onset" },
        { "distribution": 0.88, "transition": "Terminal" }
      ]
    },

    "SSI_Moderate_Risk": {
      "type": "Simple",
      "remarks": ["10% SSI incidence with obesity (no diabetes)."],
      "distributed_transition": [
        { "distribution": 0.10, "transition": "SSI_Onset" },
        { "distribution": 0.90, "transition": "Terminal" }
      ]
    },

    "SSI_Smoking_Risk": {
      "type": "Simple",
      "remarks": ["9% SSI incidence with current smoking in the absence of diabetes or obesity."],
      "distributed_transition": [
        { "distribution": 0.09, "transition": "SSI_Onset" },
        { "distribution": 0.91, "transition": "Terminal" }
      ]
    },

    "SSI_Baseline_Risk": {
      "type": "Simple",
      "remarks": ["6% SSI incidence in absence of major risk factors."],
      "distributed_transition": [
        { "distribution": 0.06, "transition": "SSI_Onset" },
        { "distribution": 0.94, "transition": "Terminal" }
      ]
    },

    "SSI_Onset": {
      "type": "ConditionOnset",
      "target_encounter": "SSI_Encounter",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "76844004",
          "display": "Infection of surgical wound"
        }
      ],
      "direct_transition": "SSI_Encounter"
    },

    "SSI_Encounter": {
      "type": "Encounter",
      "encounter_class": "outpatient",
      "reason": "SSI_Onset",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "390906007",
          "display": "Follow-up encounter"
        }
      ],
      "direct_transition": "Wound_Culture"
    },

    "Wound_Culture": {
      "type": "Observation",
      "category": "laboratory",
      "codes": [
        {
          "system": "LOINC",
          "code": "6463-4",
          "display": "Bacteria identified in Wound by Culture"
        }
      ],
      "remarks": [
        "Nominal/coded observation — reports identified organism.",
        "E. coli models a common gram-negative wound pathogen after vascular surgery."
      ],
      "value_code": {
        "system": "SNOMED-CT",
        "code": "112283007",
        "display": "Escherichia coli"
      },
      "direct_transition": "SSI_Antibiotic_Order"
    },

    "SSI_Antibiotic_Order": {
      "type": "MedicationOrder",
      "assign_to_attribute": "ssi_antibiotic",
      "reason": "SSI_Onset",
      "remarks": [
        "Cephalexin for outpatient SSI management.",
        "Patients requiring IV therapy will be captured in SSI_Rehospitalization."
      ],
      "codes": [
        {
          "system": "RxNorm",
          "code": "2673",
          "display": "cephalexin"
        }
      ],
      "direct_transition": "End_SSI_Encounter"
    },

    "End_SSI_Encounter": {
      "type": "EncounterEnd",
      "direct_transition": "SSI_Treatment_Delay"
    },

    "SSI_Treatment_Delay": {
      "type": "Delay",
      "remarks": ["Standard antibiotic course for wound infection: 7-14 days."],
      "range": { "low": 7, "high": 14, "unit": "days" },
      "direct_transition": "SSI_Resolution_Check"
    },

    "SSI_Resolution_Check": {
      "type": "Simple",
      "remarks": [
        "85% of SSIs resolve with outpatient management.",
        "15% require rehospitalization and operative debridement."
      ],
      "distributed_transition": [
        { "distribution": 0.85, "transition": "SSI_Resolution" },
        { "distribution": 0.15, "transition": "SSI_Rehospitalization" }
      ]
    },

    "SSI_Resolution": {
      "type": "ConditionEnd",
      "condition_onset": "SSI_Onset",
      "direct_transition": "SSI_Antibiotic_End"
    },

    "SSI_Rehospitalization": {
      "type": "Encounter",
      "encounter_class": "inpatient",
      "reason": "SSI_Onset",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "32485007",
          "display": "Hospital admission"
        }
      ],
      "direct_transition": "Reoperation_Procedure"
    },

    "Reoperation_Procedure": {
      "type": "Procedure",
      "reason": "SSI_Onset",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "118294005",
          "display": "Debridement"
        }
      ],
      "duration": { "low": 30, "high": 120, "unit": "minutes" },
      "direct_transition": "End_Rehospitalization"
    },

    "End_Rehospitalization": {
      "type": "EncounterEnd",
      "direct_transition": "Post_Reoperation_Delay"
    },

    "Post_Reoperation_Delay": {
