    "CHF_Onset": {
      "type": "ConditionOnset",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "84114007",
          "display": "Heart failure"
        }
      ],
      "direct_transition": "Functional_Impairment_Chance"
    },

    "Functional_Impairment_Chance": {
      "type": "Simple",
      "remarks": [
        "Barthel functional status assessment recorded for all patients.",
        "  75% independent on both transfers and ambulation",
        "  15% transfer independently but need 1-person help to ambulate",
        "  10% wheelchair bound (major help transferring)"
      ],
      "distributed_transition": [
        { "distribution": 0.75, "transition": "Barthel_Independent_Transferring" },
        { "distribution": 0.15, "transition": "Barthel_One_Person_Help_Transferring" },
        { "distribution": 0.10, "transition": "Barthel_Wheelchair_Transferring" }
      ]
    },

