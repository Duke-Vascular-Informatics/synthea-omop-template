    "Prior_Revascularization_Procedure": {
      "type": "Procedure",
      "reason": "PAD_Onset",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "112828007",
          "display": "Femoral-popliteal artery bypass graft"
        }
      ],
