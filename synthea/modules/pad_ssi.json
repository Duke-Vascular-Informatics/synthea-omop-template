      "direct_transition": "ABI_Observation"
    },

    "End_PAD_Diagnosis_Encounter": {
      "type": "EncounterEnd",
      "direct_transition": "Treatment_Strategy"
    },

    "Treatment_Strategy": {
      "type": "Simple",
      "remarks": [
        "Treatment decision following PAD evaluation.",
        "Oversampled for open surgical procedures to maximize SSI outcome data.",
        "Medical management (10%): antiplatelet, statin, exercise therapy — no procedure.",
        "Endovascular (10%): balloon angioplasty / stenting — not an open surgery, exits pathway.",
        "Open surgical (80%): open lower extremity revascularization — proceeds to SSI pathway."
      ],
      "distributed_transition": [
        { "distribution": 0.10, "transition": "Medical_Management" },
        { "distribution": 0.10, "transition": "Endovascular_Procedure_Encounter" },
        { "distribution": 0.80, "transition": "Urgent_Case_Chance" }
      ]
    },

    "Medical_Management": {
      "type": "Simple",
      "remarks": [
        "Patient managed with medical therapy only.",
        "No revascularization — exits the module."
      ],
      "direct_transition": "Terminal"
    },

    "Endovascular_Procedure_Encounter": {
      "type": "Encounter",
      "encounter_class": "outpatient",
      "reason": "PAD_Onset",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "11429006",
          "display": "Consultation"
        }
