      "codes": [
        {
          "system": "LOINC",
          "code": "72166-2",
          "display": "Tobacco smoking status"
        }
      ],
      "value_code": {
        "system": "SNOMED-CT",
        "code": "221000119102",
        "display": "Never smoked any substance"
      },
