      "value_code": {
        "system": "LOINC",
        "code": "LA12302-8",
        "display": "Independent"
      },
      "direct_transition": "BMI_Chance"
    },

    "Barthel_One_Person_Help_Transferring": {
      "type": "Observation",
      "category": "survey",
      "codes": [
        {
          "system": "LOINC",
          "code": "83185-9",
          "display": "Transferring - functional ability"
        }
      ],
      "value_code": {
        "system": "LOINC",
        "code": "LA12302-8",
        "display": "Independent"
      },
      "direct_transition": "Barthel_One_Person_Help_Ambulation"
    },

    "Barthel_One_Person_Help_Ambulation": {
