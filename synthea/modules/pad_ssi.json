        {
          "system": "LOINC",
          "code": "6463-4",
          "display": "Bacteria identified in Wound by Culture"
        }
      ],
      "remarks": [
        "Nominal/coded observation — reports identified organism.",
        "E. coli models a common gram-negative wound pathogen after vascular surgery."
      ],
      "value_code": {
        "system": "SNOMED-CT",
        "code": "112283007",
        "display": "Escherichia coli"
      },
      "direct_transition": "SSI_Antibiotic_Order"
    },

    "SSI_Antibiotic_Order": {
      "type": "MedicationOrder",
      "assign_to_attribute": "ssi_antibiotic",
      "reason": "SSI_Onset",
      "remarks": [
        "Cephalexin for outpatient SSI management.",
        "Patients requiring IV therapy will be captured in SSI_Rehospitalization."
      ],
      "codes": [
        {
          "system": "RxNorm",
          "code": "2673",
          "display": "cephalexin"
        }
      ],
      "direct_transition": "End_SSI_Encounter"
    },

    "End_SSI_Encounter": {
      "type": "EncounterEnd",
      "direct_transition": "SSI_Treatment_Delay"
    },

    "SSI_Treatment_Delay": {
      "type": "Delay",
      "remarks": ["Standard antibiotic course for wound infection: 7-14 days."],
      "range": { "low": 7, "high": 14, "unit": "days" },
      "direct_transition": "SSI_Resolution_Check"
    },

    "SSI_Resolution_Check": {
      "type": "Simple",
      "remarks": [
        "85% of SSIs resolve with outpatient management.",
        "15% require rehospitalization and operative debridement."
      ],
      "distributed_transition": [
        { "distribution": 0.85, "transition": "SSI_Resolution" },
        { "distribution": 0.15, "transition": "SSI_Rehospitalization" }
      ]
    },

    "SSI_Resolution": {
      "type": "ConditionEnd",
      "condition_onset": "SSI_Onset",
      "direct_transition": "SSI_Antibiotic_End"
    },

    "SSI_Rehospitalization": {
      "type": "Encounter",
      "encounter_class": "inpatient",
      "reason": "SSI_Onset",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "32485007",
          "display": "Hospital admission"
        }
      ],
      "direct_transition": "Reoperation_Procedure"
    },

    "Reoperation_Procedure": {
      "type": "Procedure",
      "reason": "SSI_Onset",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "118294005",
          "display": "Debridement"
        }
      ],
      "duration": { "low": 30, "high": 120, "unit": "minutes" },
      "direct_transition": "End_Rehospitalization"
    },

    "End_Rehospitalization": {
      "type": "EncounterEnd",
      "direct_transition": "Post_Reoperation_Delay"
    },

    "Post_Reoperation_Delay": {
      "type": "Delay",
      "range": { "low": 7, "high": 21, "unit": "days" },
      "direct_transition": "SSI_End_From_Reoperation"
    },

    "SSI_End_From_Reoperation": {
      "type": "ConditionEnd",
      "condition_onset": "SSI_Onset",
      "direct_transition": "SSI_Antibiotic_End"
    },

    "SSI_Antibiotic_End": {
      "type": "MedicationEnd",
      "referenced_by_attribute": "ssi_antibiotic",
      "direct_transition": "Terminal"
    },

    "Terminal": {
      "type": "Terminal"
    }

  }
}
