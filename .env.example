# =============================================================================
# .env.example — Analysis-Specific Environment Variables (Study Template)
#
# Copy this file to .env and fill in your values.
# .env is gitignored and must NEVER be committed to version control.
#
# Scope: this file contains ONLY analysis-specific variables that have no
# home elsewhere — namely the GitHub origin (reference). Schemas and CDM metadata
# (cdm_schema, results_schema, cdm_database_*) live in study_params.yaml.
# Shared values (SQL Server container, API keys, base OMOP connection
# details, institutional CDM/results schemas, JDBC wrapper) live in the
# workspace .env.
#
# Load order:
#   1. Devcontainer loads /workspace/.env into the container environment.
#   2. .Rprofile loads this study's .env when R starts in this directory.
# =============================================================================

# -----------------------------------------------------------------------------
# Source repository — GitHub remote (reference)
# Documentation only; the active remote is configured via `git remote -v`.
# -----------------------------------------------------------------------------
STUDY_GITHUB_REMOTE=https://github.com/Duke-Vascular-Informatics/synthea-omop-template.git
