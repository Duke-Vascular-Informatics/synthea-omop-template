# =============================================================================
# .env.example — Institution-Specific Environment Variables
#
# Copy this file to .env and fill in your values.
# .env is gitignored and must NEVER be committed to version control.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your institution's values
#
# These variables are loaded automatically by .Rprofile when R starts.
# =============================================================================

# ---------------------------------------------------------------------------
# CRAN mirror — set to your institution's preferred mirror.
# Leave blank or omit to use the default: https://cloud.r-project.org
# ---------------------------------------------------------------------------
CRAN_MIRROR=https://cloud.r-project.org

# ---------------------------------------------------------------------------
# SQL Server connection
# Required for the portable bundle and any non-devcontainer workflow.
# ---------------------------------------------------------------------------

# SQL Server hostname (no port for default 1433; use host:port otherwise)
OMOP_SERVER=your.sql.server.hostname

# Database containing the OMOP CDM tables
OMOP_DATABASE=your_omop_database

# Schema containing shared OMOP vocabulary tables (concept, concept_ancestor, etc.)
OMOP_VOCAB_SCHEMA=omop_vocab

# CDM schema (person, visit_occurrence, condition_occurrence, etc.)
OMOP_CDM_SCHEMA=cdm_your_study

# Results/work schema — must have CREATE/INSERT/DROP rights here
OMOP_RESULTS_SCHEMA=your_results_schema

# Kerberos SPN host (hostname only — no port, no MSSQLSvc/ prefix)
# Required only when using Kerberos authentication on an HPC cluster
OMOP_SPN_HOST=your.spn.hostname

# ---------------------------------------------------------------------------
# CDM metadata — written into output files and reports
# ---------------------------------------------------------------------------
OMOP_CDM_DATABASE_ID=your_cdm_v5.4
OMOP_CDM_DATABASE_NAME=Your Institution OMOP CDM
OMOP_CDM_DATABASE_DESCRIPTION=Brief description of the patient population and database.

# ---------------------------------------------------------------------------
# Transportable bundle — Git remote and identity for bundle deployment
# Used by workflow/09_build_portable_analysis_bundle.sh
# ---------------------------------------------------------------------------
BUNDLE_GITLAB_REMOTE=git@your.gitlab.instance:yourorg/your-bundle.git
BUNDLE_GIT_USER_NAME=Your Name
BUNDLE_GIT_USER_EMAIL=your.email@institution.edu

# ---------------------------------------------------------------------------
# Institution-provided JDBC wrapper JAR for Kerberos authentication.
# Set to the absolute path of the JAR on the protected analytic space.
# Leave blank if your institution uses standard SQL authentication instead.
# ---------------------------------------------------------------------------
OMOP_HPC_JAR=/path/to/your/workspace/drivers/hpc-jdbc-wrapper.jar

# ---------------------------------------------------------------------------
# Workspace SQL Server defaults (injected by root-level workspace setup).
# Uncomment only for standalone runs outside the shared workspace container.
# ---------------------------------------------------------------------------
# MSSQL_HOST=localhost
# MSSQL_SA_PASSWORD=P@ssw0rd!
