{
  "name": "PAD OLER SSI Validation (R + SQL Server)",
  "dockerComposeFile": ["docker-compose.extend.yml"],
  "service": "devcontainer",
  "workspaceFolder": "/workspace",
  "remoteEnv": {
    "MSSQL_HOST": "mssql_dev",
    "SSH_AUTH_SOCK": "/run/host-services/ssh-auth.sock"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-mssql.mssql",
        "REditorSupport.r",
        "RDebugger.r-debugger"
      ],
      "settings": {
        "r.rterm.linux": "/usr/local/bin/R",
        "r.rpath.linux": "/usr/local/bin/R"
      }
    }
  },
  "postCreateCommand": "cd /workspace && R -e \"if (file.exists('renv/activate.R')) source('renv/activate.R')\"",
  "remoteUser": "root"
}
