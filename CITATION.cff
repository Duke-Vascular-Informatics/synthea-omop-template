  - type: software
    title: "OHDSI Achilles"
    authors:
      - name: "Observational Health Data Sciences and Informatics (OHDSI)"
    url: "https://github.com/OHDSI/Achilles"

  - type: software
    title: "OHDSI DataQualityDashboard"
    authors:
      - name: "Observational Health Data Sciences and Informatics (OHDSI)"
    url: "https://github.com/OHDSI/DataQualityDashboard"
